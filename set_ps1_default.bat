@echo off
setlocal EnableExtensions
cd /d "%~dp0"

set "pause_after=1"
set "ans="
if /i "%~1"=="/nopause" set "pause_after=0"
if /i "%~2"=="/nopause" set "pause_after=0"
if /i "%~1"=="/y" set "ans=Y"
if /i "%~2"=="/y" set "ans=Y"
set "PSH=%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe"
set "REG=%SystemRoot%\System32\reg.exe"

if not defined ans (
  "%PSH%" -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
  if errorlevel 1 exit /b 0
)

set "cmd_failed=0"

%REG% add "HKCU\Software\Classes\.ps1" /ve /t REG_SZ /d "Microsoft.PowerShellScript.1" /f >nul 2>&1
if errorlevel 1 set "cmd_failed=1"

%REG% add "HKCU\Software\Classes\Microsoft.PowerShellScript.1\shell\open\command" /ve /t REG_SZ /d "\"%PSH%\" -ExecutionPolicy Bypass -File \"%%1\"" /f >nul 2>&1
if errorlevel 1 set "cmd_failed=1"

if "%cmd_failed%"=="1" (
  "%PSH%" -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
)

%REG% delete "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.ps1\UserChoice" /f >nul 2>&1

taskkill /f /im explorer.exe >nul 2>&1
start "" explorer.exe >nul 2>&1

%REG% query "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.ps1\UserChoice" /v Progid >nul 2>&1
if errorlevel 1 goto done_ok

%PSH% -NoProfile -ExecutionPolicy Bypass -EncodedCommand 

%REG% query "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.ps1\UserChoice" /v Progid >nul 2>&1
if errorlevel 1 goto done_ok

%PSH% -NoProfile -ExecutionPolicy Bypass -EncodedCommand 

set "rc=1"
goto finish

:done_ok
%PSH% -NoProfile -ExecutionPolicy Bypass -EncodedCommand VwByAGkAdABlAC0ASABvAHMAdAAgACcAJwA7ACAAVwByAGkAdABlAC0ASABvAHMAdAAgACcA8l2ZUWVRc1FUgL6Lbn8I/1NfTVIodTdiCf8CMIJZnGfMU/tRzU4vZrCLi04sZwz/94sJYyAAUgBFAEEARABNAEUAIACEdktiqFJla6SavotufwBOIWsCMCcA
set "rc=0"

:finish
echo.
if "%pause_after%"=="1" pause
exit /b %rc%
